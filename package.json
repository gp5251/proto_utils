{
  "name": "proto-utils",
  "displayName": "Proto Utils",
  "description": "Proto3 syntax highlighting, go-to-definition, and TypeScript code generation",
  "version": "0.2.1",
  "publisher": "proto-utils",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onLanguage:proto3",
    "onCommand:protoUtils.openRpcRunner"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "proto3",
        "aliases": [
          "Protocol Buffers 3",
          "proto3"
        ],
        "extensions": [
          ".proto"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "proto3",
        "scopeName": "source.proto3",
        "path": "./syntaxes/proto3.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "protoUtils.generateTypes",
        "title": "Proto Utils: Generate TypeScript Types"
      },
      {
        "command": "protoUtils.openRpcRunner",
        "title": "Proto Utils: Open RPC Runner"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == proto3",
          "command": "protoUtils.generateTypes",
          "group": "protoUtils"
        },
        {
          "when": "resourceLangId == proto3",
          "command": "protoUtils.openRpcRunner",
          "group": "protoUtils"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId == proto3",
          "command": "protoUtils.generateTypes",
          "group": "protoUtils"
        }
      ]
    },
    "configuration": {
      "title": "Proto Utils",
      "properties": {
        "protoUtils.runner.server": {
          "type": "string",
          "default": "localhost:50051",
          "description": "gRPC server address (host:port) for RPC Runner calls"
        },
        "protoUtils.runner.protoDir": {
          "type": "string",
          "default": "",
          "description": "Proto directory for RPC Runner; empty = workspace root; relative paths resolve against the workspace folder"
        },
        "protoUtils.codeGen.outputDir": {
          "type": "string",
          "default": "generated",
          "description": "Output directory for generated TypeScript files (relative to workspace root)"
        },
        "protoUtils.codeGen.enumStyle": {
          "type": "string",
          "enum": [
            "enum",
            "union"
          ],
          "default": "enum",
          "description": "Generate enums as TypeScript enum or union type"
        },
        "protoUtils.codeGen.optionalMessageFields": {
          "type": "boolean",
          "default": true,
          "description": "Mark non-repeated message-typed fields as optional (?)"
        },
        "protoUtils.codeGen.optionalScalarFields": {
          "type": "boolean",
          "default": false,
          "description": "Mark scalar fields as optional (?)"
        },
        "protoUtils.codeGen.fieldNaming": {
          "type": "string",
          "enum": [
            "camelCase",
            "preserve"
          ],
          "default": "camelCase",
          "description": "Field naming convention in generated TypeScript"
        },
        "protoUtils.codeGen.pathMapping": {
          "type": "string",
          "enum": [
            "package",
            "file"
          ],
          "default": "package",
          "description": "Derive output file path from proto package declaration or file path"
        },
        "protoUtils.codeGen.oneofStyle": {
          "type": "string",
          "enum": [
            "optional",
            "union"
          ],
          "default": "optional",
          "description": "Generate oneof as simple optional fields or discriminated union"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run typecheck && npm run compile -- --production",
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "alpinejs": "^3.15.12",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "protobufjs": "^8.7.1"
  }
}
