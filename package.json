{
  "name": "proto-utils",
  "displayName": "Proto Utils",
  "l10n": "./l10n",
  "description": "%extension.description%",
  "version": "0.3.34",
  "publisher": "paulgui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gp5251/proto_utils"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onLanguage:proto3",
    "onCommand:protoUtils.openRpcRunner"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "proto3",
        "aliases": [
          "Protocol Buffers 3",
          "proto3"
        ],
        "extensions": [
          ".proto"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "proto3",
        "scopeName": "source.proto3",
        "path": "./syntaxes/proto3.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "protoUtils.generateTypes",
        "title": "%command.generateTypes%"
      },
      {
        "command": "protoUtils.generateAllTypes",
        "title": "%command.generateAllTypes%"
      },
      {
        "command": "protoUtils.openRpcRunner",
        "title": "%command.openRpcRunner%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == proto3",
          "command": "protoUtils.generateTypes",
          "group": "protoUtils"
        },
        {
          "when": "resourceLangId == proto3",
          "command": "protoUtils.generateAllTypes",
          "group": "protoUtils"
        },
        {
          "when": "resourceLangId == proto3",
          "command": "protoUtils.openRpcRunner",
          "group": "protoUtils"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId == proto3",
          "command": "protoUtils.generateTypes",
          "group": "protoUtils"
        },
        {
          "when": "resourceLangId == proto3",
          "command": "protoUtils.generateAllTypes",
          "group": "protoUtils"
        }
      ]
    },
    "configuration": {
      "title": "Proto Utils",
      "properties": {
        "protoUtils.runner.server": {
          "type": "string",
          "default": "localhost:50051",
          "description": "%config.runner.server%"
        },
        "protoUtils.runner.protoDir": {
          "type": "string",
          "default": "",
          "description": "%config.runner.protoDir%"
        },
        "protoUtils.codeGen.outputDir": {
          "type": "string",
          "default": "generated",
          "description": "%config.codeGen.outputDir%"
        },
        "protoUtils.codeGen.enumStyle": {
          "type": "string",
          "enum": [
            "enum",
            "union"
          ],
          "default": "enum",
          "description": "%config.codeGen.enumStyle%"
        },
        "protoUtils.codeGen.optionalMessageFields": {
          "type": "boolean",
          "default": true,
          "description": "%config.codeGen.optionalMessageFields%"
        },
        "protoUtils.codeGen.optionalScalarFields": {
          "type": "boolean",
          "default": false,
          "description": "%config.codeGen.optionalScalarFields%"
        },
        "protoUtils.codeGen.fieldNaming": {
          "type": "string",
          "enum": [
            "camelCase",
            "preserve"
          ],
          "default": "camelCase",
          "description": "%config.codeGen.fieldNaming%"
        },
        "protoUtils.codeGen.pathMapping": {
          "type": "string",
          "enum": [
            "file",
            "package"
          ],
          "default": "file",
          "description": "%config.codeGen.pathMapping%"
        },
        "protoUtils.codeGen.importExtension": {
          "type": "string",
          "enum": [
            "ts",
            "none"
          ],
          "default": "ts",
          "description": "%config.codeGen.importExtension%"
        },
        "protoUtils.scan.excludeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.scan.excludeDirs%"
        },
        "protoUtils.codeGen.oneofStyle": {
          "type": "string",
          "enum": [
            "optional",
            "union"
          ],
          "default": "optional",
          "description": "%config.codeGen.oneofStyle%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run typecheck && npm run compile -- --production",
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@alpinejs/csp": "^3.15.12",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "json5": "^2.2.3",
    "protobufjs": "^8.7.1"
  }
}
