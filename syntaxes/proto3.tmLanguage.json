{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Protocol Buffers 3",
  "scopeName": "source.proto3",
  "patterns": [
    { "include": "#comments" },
    { "include": "#syntax" },
    { "include": "#package" },
    { "include": "#import" },
    { "include": "#option-statement" },
    { "include": "#message" },
    { "include": "#enum" },
    { "include": "#service" },
    { "include": "#reserved" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.proto3",
          "match": "//.*$"
        },
        {
          "name": "comment.block.proto3",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "syntax": {
      "match": "\\b(syntax)\\s*(=)\\s*(\"proto[23]\")\\s*(;)",
      "captures": {
        "1": { "name": "keyword.other.syntax.proto3" },
        "2": { "name": "keyword.operator.assignment.proto3" },
        "3": { "name": "string.quoted.double.proto3" },
        "4": { "name": "punctuation.terminator.proto3" }
      }
    },
    "package": {
      "match": "\\b(package)\\s+([a-zA-Z_][a-zA-Z0-9_.]*)\\s*(;)",
      "captures": {
        "1": { "name": "keyword.other.package.proto3" },
        "2": { "name": "entity.name.namespace.proto3" },
        "3": { "name": "punctuation.terminator.proto3" }
      }
    },
    "import": {
      "match": "\\b(import)\\s+(weak|public)?\\s*(\"[^\"]*\")\\s*(;)",
      "captures": {
        "1": { "name": "keyword.other.import.proto3" },
        "2": { "name": "keyword.other.import-modifier.proto3" },
        "3": { "name": "string.quoted.double.proto3" },
        "4": { "name": "punctuation.terminator.proto3" }
      }
    },
    "option-statement": {
      "begin": "\\b(option)\\s+((?:\\([^()\\s]+\\)(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*|[a-zA-Z_][a-zA-Z0-9_.]*))\\s*(=)",
      "beginCaptures": {
        "1": { "name": "keyword.other.option.proto3" },
        "2": { "name": "variable.other.option.proto3" },
        "3": { "name": "keyword.operator.assignment.proto3" }
      },
      "end": ";",
      "endCaptures": {
        "0": { "name": "punctuation.terminator.proto3" }
      },
      "patterns": [
        { "include": "#comments" },
        { "match": "\"[^\"]*\"", "name": "string.quoted.double.proto3" },
        { "match": "\\b(true|false)\\b", "name": "constant.language.boolean.proto3" },
        { "match": "-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?", "name": "constant.numeric.proto3" },
        { "match": "[{}\\[\\]]", "name": "punctuation.definition.block.proto3" }
      ]
    },
    "message": {
      "begin": "\\b(message)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.other.message.proto3" },
        "2": { "name": "entity.name.type.message.proto3" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.proto3" }
      },
      "patterns": [
        { "include": "#comments" },
        { "match": "\\{", "name": "punctuation.definition.block.proto3" },
        { "include": "#message" },
        { "include": "#enum" },
        { "include": "#oneof" },
        { "include": "#map-field" },
        { "include": "#field" },
        { "include": "#reserved" },
        { "include": "#option-statement" }
      ]
    },
    "enum": {
      "begin": "\\b(enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.other.enum.proto3" },
        "2": { "name": "entity.name.type.enum.proto3" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.proto3" }
      },
      "patterns": [
        { "include": "#comments" },
        { "match": "\\{", "name": "punctuation.definition.block.proto3" },
        { "include": "#option-statement" },
        { "include": "#reserved" },
        {
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)\\s*(-?\\d+)",
          "captures": {
            "1": { "name": "variable.other.enummember.proto3" },
            "2": { "name": "keyword.operator.assignment.proto3" },
            "3": { "name": "constant.numeric.proto3" }
          }
        }
      ]
    },
    "service": {
      "begin": "\\b(service)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.other.service.proto3" },
        "2": { "name": "entity.name.type.service.proto3" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.proto3" }
      },
      "patterns": [
        { "include": "#comments" },
        { "match": "\\{", "name": "punctuation.definition.block.proto3" },
        { "include": "#option-statement" },
        { "include": "#rpc" }
      ]
    },
    "rpc": {
      "begin": "\\b(rpc)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.other.rpc.proto3" },
        "2": { "name": "entity.name.function.rpc.proto3" }
      },
      "end": "(;|\\})",
      "endCaptures": {
        "0": { "name": "punctuation.terminator.proto3" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#option-statement" },
        {
          "begin": "\\(",
          "beginCaptures": { "0": { "name": "punctuation.definition.parameters.proto3" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.definition.parameters.proto3" } },
          "patterns": [
            { "include": "#comments" },
            { "match": "\\bstream\\b\\s*", "name": "keyword.other.stream.proto3" },
            { "match": "\\.?[a-zA-Z_][a-zA-Z0-9_.]*", "name": "entity.name.type.proto3" }
          ]
        },
        { "match": "\\breturns\\b", "name": "keyword.other.returns.proto3" },
        { "match": "\\{", "name": "punctuation.definition.block.proto3" }
      ]
    },
    "oneof": {
      "begin": "\\b(oneof)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.other.oneof.proto3" },
        "2": { "name": "variable.other.oneof.proto3" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.proto3" }
      },
      "patterns": [
        { "include": "#comments" },
        { "match": "\\{", "name": "punctuation.definition.block.proto3" },
        { "include": "#field" }
      ]
    },
    "map-field": {
      "match": "\\b(map)\\s*(<)\\s*(\\.?[a-zA-Z_][a-zA-Z0-9_.]*)\\s*(,)\\s*(\\.?[a-zA-Z_][a-zA-Z0-9_.]*)\\s*(>)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)\\s*(\\d+)",
      "captures": {
        "1": { "name": "keyword.other.map.proto3" },
        "2": { "name": "punctuation.definition.typeparameters.proto3" },
        "3": { "name": "support.type.scalar.proto3" },
        "4": { "name": "punctuation.separator.proto3" },
        "5": { "name": "entity.name.type.proto3" },
        "6": { "name": "punctuation.definition.typeparameters.proto3" },
        "7": { "name": "variable.other.field.proto3" },
        "8": { "name": "keyword.operator.assignment.proto3" },
        "9": { "name": "constant.numeric.proto3" }
      }
    },
    "field": {
      "match": "\\b(repeated)?\\s*(double|float|int32|int64|uint32|uint64|sint32|sint64|fixed32|fixed64|sfixed32|sfixed64|bool|string|bytes|\\.?[a-zA-Z_][a-zA-Z0-9_.]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)\\s*(\\d+)",
      "captures": {
        "1": { "name": "keyword.other.repeated.proto3" },
        "2": { "name": "entity.name.type.proto3" },
        "3": { "name": "variable.other.field.proto3" },
        "4": { "name": "keyword.operator.assignment.proto3" },
        "5": { "name": "constant.numeric.proto3" }
      }
    },
    "reserved": {
      "match": "\\b(reserved)\\s+(.*?)(;)",
      "captures": {
        "1": { "name": "keyword.other.reserved.proto3" },
        "2": { "patterns": [
          { "match": "\\d+", "name": "constant.numeric.proto3" },
          { "match": "\"[^\"]*\"", "name": "string.quoted.double.proto3" }
        ]},
        "3": { "name": "punctuation.terminator.proto3" }
      }
    }
  }
}
